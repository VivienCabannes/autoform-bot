#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Run-from-checkout shim for the autoform worker CLI (mirrors TauCeti's ./tauceti).

Installed wheels expose this as the `autoform-worker` console script; a checkout
gets it via `./autoform-worker ...` with zero setup beyond uv. The name matches
that console script deliberately: `autoform` is the blueprint CLI
(`autoform_cli.__main__`), so the two must not be the same command with
different behaviour depending on how you installed.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from autoform_worker.cli import cli_main  # noqa: E402

raise SystemExit(cli_main())
