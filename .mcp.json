{
  "mcpServers": {
    "lean-lsp-mcp": {
      "command": "lean-lsp-mcp",
      "args": ["--disable-tools", "lean_leansearch,lean_loogle,lean_leanfinder"],
      "startup_timeout_sec": 120
    },
    "autoform-prover": {
      "command": "bash",
      "args": ["-lc", "cd \"${CLAUDE_PLUGIN_ROOT:-.}\" && exec uv run python -m servers.prover.server"],
      "cwd": ".",
      "env": {"UV_PROJECT_ENVIRONMENT": ".venv-autoform-prover"},
      "startup_timeout_sec": 120
    }
  }
}
