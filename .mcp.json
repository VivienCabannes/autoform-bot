{
  "mcpServers": {
    "lean-informal-planner-mathlib": {
      "command": "uv",
      "args": ["run", "python", "-m", "servers.mathlib.server"],
      "cwd": "."
    },
    "autoform-repl": {
      "command": "uv",
      "args": ["run", "--extra", "repl", "python", "-m", "servers.repl.server"],
      "cwd": "."
    },
    "autoform-lsp": {
      "command": "uv",
      "args": ["run", "python", "-m", "servers.lsp.server"],
      "cwd": "."
    },
    "autoform-aristotle": {
      "command": "uv",
      "args": ["run", "--extra", "aristotle", "python", "-m", "servers.aristotle.server"],
      "cwd": "."
    },
    "autoform-prover": {
      "command": "uv",
      "args": ["run", "python", "-m", "servers.prover.server"],
      "cwd": "."
    },
    "autoform-zulip": {
      "command": "uv",
      "args": ["run", "--extra", "zulip", "python", "-m", "servers.zulip.server"],
      "cwd": "."
    }
  }
}
