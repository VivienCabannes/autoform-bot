#!/usr/bin/env bash
# SessionStart hook — describe Autoform's portable workflow.
# Silent-fails on all errors (never blocks session start).

set -euo pipefail

context="Autoform is active. It turns mathematical sources into a durable Lean 4 formalization graph, proves nodes through explicitly selected backends, independently verifies every proof, and records a three-axis review jury. Use the setup, orchestrate, set-backend, plan, plan-view, review, workspace, and proof skills when relevant. Claude and Codex use their native skills, MCP servers, and subagents against the same graph and queue. Ask for source files and scope before beginning a new plan."

escape_for_json() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

escaped_context="$(escape_for_json "$context")"
printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$escaped_context"
